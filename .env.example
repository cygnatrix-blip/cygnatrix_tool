# ─────────────────────────────────────────────────────────────────────────────
# Cygnatrix Tools — environment configuration
# Copy to .env.local for local dev. Set the real values in Hostinger hPanel for prod.
# NOTHING secret is committed. Public (NEXT_PUBLIC_*) values are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# --- Site -------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for metadata, canonicals, sitemap, OG.
NEXT_PUBLIC_SITE_URL=https://tools.cygnatrix.com
NEXT_PUBLIC_SITE_NAME=Cygnatrix Tools

# --- Database (OPTIONAL) ----------------------------------------------------
# Leave blank to run without persistence (analytics + contact form become no-ops).
# Hostinger gives you host/user/pass/db in hPanel > Databases.
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
# Connection pool size — keep small on shared hosting.
DATABASE_POOL_LIMIT=5

# --- Analytics ------------------------------------------------------------
# GA4 measurement id (optional). Script only loads after cookie consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Salt used to hash visitor IPs before storage. Generate: openssl rand -hex 16
ANALYTICS_IP_SALT=change-me-to-a-random-32-char-string

# --- Google AdSense -----------------------------------------------------
# Publisher id, e.g. ca-pub-XXXXXXXXXXXXXXXX. Leave blank to disable all ads.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Per-slot ids (create in AdSense dashboard). Comma-free numeric ids.
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORY=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_RESULT=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=
# When true, render a labelled reserved-space box where ads would go (useful pre-approval).
NEXT_PUBLIC_ADS_PLACEHOLDER=false

# --- Security / limits -------------------------------------------------
# Requests per minute per IP for /api/* endpoints.
RATE_LIMIT_PER_MINUTE=30
# Contact form submissions per hour per IP.
CONTACT_RATE_LIMIT_PER_HOUR=5

# --- Contact ----------------------------------------------------------------
# Where contact form notifications are conceptually delivered (not wired to SMTP in MVP —
# messages are stored in DB; set this for future email integration).
CONTACT_NOTIFY_EMAIL=support@cygnatrix.com

# --- Runtime --------------------------------------------------------------
# Port is provided by Hostinger automatically; only set locally if 3000 is taken.
# PORT=3000
